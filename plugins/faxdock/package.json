{
  "name": "faxdock",
  "version": "1.3.2",
  "description": "Local PDF fax drafts and simulation. Connect your own Phaxio account for approved sends; you pay your provider. Sending is disabled by default.",
  "main": "src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "web": "node src/web.js",
    "smoke": "node test/mcp-smoke.js",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "smoke:package": "node test/package-smoke.js"
  },
  "keywords": [],
  "author": "Adam Designs LLC",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "files": [
    "src",
    "public",
    "skills",
    "assets",
    ".codex-plugin",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    "README.md",
    ".env.example"
  ]
}
