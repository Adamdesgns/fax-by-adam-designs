{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "faxdock": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/src/server.js"
      ],
      "cwd": "./",
      "env": {
        "FAX_TRANSPORT": "disabled",
        "FAX_DATA_DIR": "${PLUGIN_DATA}/fax-jobs",
        "FAX_ALLOWED_ROOTS": "${PLUGIN_DATA}"
      }
    }
  }
}
